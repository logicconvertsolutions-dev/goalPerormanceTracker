# Supabase Configuration Template
# Copy this to .env.local and fill in your actual keys
# Get values from Supabase Dashboard > Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Notifications (P5.5) -- evening nudge, Sunday summary, Monday SMD digest.
# Absolute base URL used to build deep links and unsubscribe links in emails.
# Server-only (not NEXT_PUBLIC_) -- only read from server actions/modules.
APP_URL=http://localhost:3000
# Resend API key. Sends no-op with a console warning when unset, so local
# dev works without one.
RESEND_API_KEY=
# Verified "From" address for Resend, e.g. "Team Tracker <notifications@yourdomain.com>".
NOTIFICATIONS_FROM_EMAIL=
# Server-only secret used to sign one-click unsubscribe links (HMAC-SHA256).
# Generate with: openssl rand -hex 32
NOTIFICATIONS_UNSUB_SECRET=
# Shared secret sent as `Authorization: Bearer <value>` when triggering
# /api/cron/notifications and /api/cron/notifications/drain. As of P14a,
# the caller is Supabase pg_cron (via pg_net), reading the same value from
# a Vault secret named `cron_secret` -- not Vercel Cron, not GitHub Actions.
# Leave unset to allow unauthenticated calls in local dev only -- always
# set this in production.
CRON_SECRET=
